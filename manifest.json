{
  "manifestVersion": 5,
  "id": "com.yourstudio.safezonepro",
  "name": "Safe Zone Pro",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "safeZonePanel",
      "label": { "default": "Safe Zone Pro" },
      "minimumSize": { "width": 280, "height": 420 },
      "preferredDockedSize": { "width": 280, "height": 420 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  }
}
